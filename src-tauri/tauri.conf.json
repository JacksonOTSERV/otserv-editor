{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OTServ Editor",
  "version": "0.1.4",
  "identifier": "com.otserv.editor",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OTServ Editor",
        "url": "full/app.html",
        "width": 1400,
        "height": 860,
        "resizable": true,
        "visible": true,
        "center": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--renderer-process-limit=1 --js-flags=--max-old-space-size=1024 --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,BackForwardCache,Translate --disk-cache-size=20000000 --disable-gpu-shader-disk-cache"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://SEU-BUCKET.r2.dev/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzNjFENzU0MDc1ODBFMkIKUldRckRsZ0hWTmRodzFEbWd5Z1U0R3lBalg2NlhVbEhHWEZKamdQWWNDdElrekhvL1JtejB0M0wK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
